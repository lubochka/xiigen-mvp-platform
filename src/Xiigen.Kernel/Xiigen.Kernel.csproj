<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Xiigen.Kernel</PackageId>
    <Version>0.1.1</Version>
    <Authors>XIIGen</Authors>
    <Description>XIIGen .NET kernel primitives for DataProcessResult, MicroserviceBase, tenant context, idempotency, and outbox contracts.</Description>
