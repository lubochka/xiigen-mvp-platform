<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Xiigen.Fabrics.InMemory</PackageId>
    <Version>0.1.1</Version>
    <Authors>XIIGen</Authors>
    <Description>XIIGen in-memory fabric providers for local tests and certification harnesses.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xiigen.Kernel\Xiigen.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
