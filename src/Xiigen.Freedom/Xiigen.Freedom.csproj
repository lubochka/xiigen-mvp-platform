<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Xiigen.Freedom</PackageId>
    <Version>0.1.0</Version>
    <Authors>XIIGen</Authors>
    <Description>XIIGen FREEDOM configuration contracts and local default provider.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xiigen.Kernel\Xiigen.Kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
