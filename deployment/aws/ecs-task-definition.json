{
  "family": "xiigen-flow19-durable-sagas-compliance",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "flow19-api",
      "image": "${ECR_IMAGE_URI}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "${ASPNETCORE_ENVIRONMENT}"
        },
        {
          "name": "XIIGEN_FLOW_ID",
          "value": "FLOW-19"
        },
        {
          "name": "XIIGEN_TENANT_SCOPE",
          "value": "primary-master-tenant"
        }
      ],
      "secrets": [
        {
          "name": "XIIGEN_JWT_SIGNING_SECRET",
          "valueFrom": "${JWT_SIGNING_SECRET_ARN}"
        },
        {
          "name": "XIIGEN_PLATFORM_CONNECTION",
          "valueFrom": "${PLATFORM_CONNECTION_SECRET_ARN}"
        },
        {
          "name": "XIIGEN_TENANT_BOOTSTRAP_SECRET",
          "valueFrom": "${TENANT_BOOTSTRAP_SECRET_ARN}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${CLOUDWATCH_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "flow19"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health/ready || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
