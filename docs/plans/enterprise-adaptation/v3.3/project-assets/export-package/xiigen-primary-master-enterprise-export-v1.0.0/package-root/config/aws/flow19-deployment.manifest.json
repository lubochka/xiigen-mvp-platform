{
  "schemaVersion": "1.0.0",
  "owner": "FLOW-19",
  "provider": "aws",
  "deploymentMode": "local-runner-to-aws",
  "githubActions": {
    "enabled": false,
    "reason": "GitHub Actions are disabled for this account; FLOW-19 deployment is executed by the local/AWS runner."
  },
  "source": {
    "platformRepo": "C:/Projects/xiigen-platform-dot-net-angular",
    "flowsRepo": "C:/Projects/xiigen-flows-dot-net-angular",
    "flowPath": "flows/FLOW-19-durable-sagas-compliance",
    "serverEntrypoint": "server/Xiigen.Flow.DurableSagasCompliance.Api",
    "clientEntrypoint": "client/angular",
    "serverDockerfile": "flows/FLOW-19-durable-sagas-compliance/server/Xiigen.Flow.DurableSagasCompliance.Api/Dockerfile",
    "flowManifest": "flows/FLOW-19-durable-sagas-compliance/flow.manifest.json"
  },
  "artifactOutputs": {
    "localRoot": "artifacts/enterprise-deploy/FLOW-19",
    "clientDist": "artifacts/enterprise-deploy/FLOW-19/client-dist",
    "packageArchive": "artifacts/enterprise-deploy/FLOW-19/FLOW-19-enterprise-package.zip",
    "runnerEvidence": "docs/plans/enterprise-adaptation/v3.3/evidence/AWS-CICD-EVIDENCE.json",
    "auditEvent": "docs/plans/enterprise-adaptation/v3.3/evidence/FLOW-19-AWS-DEPLOYMENT-AUDIT.json"
  },
  "aws": {
    "regionParameter": "Region",
    "accountIdParameter": "AwsAccountId",
    "environmentParameter": "EnvironmentName",
    "ecr": {
      "repositoryParameter": "EcrRepository",
      "defaultRepository": "xiigen/flow-19-durable-sagas-compliance",
      "imageTagFormat": "{environment}-{commitSha}"
    },
    "ecs": {
      "clusterParameter": "EcsCluster",
      "serviceParameter": "EcsService",
      "taskDefinitionFile": "deployment/aws/ecs-task-definition.json",
      "containerName": "flow19-api",
      "containerPort": 8080,
      "launchType": "FARGATE"
    },
    "routing": {
      "albDnsNameParameter": "AlbDnsName",
      "cloudFrontDomainParameter": "CloudFrontDomain",
      "route53RecordParameter": "Route53Record",
      "hostedBaseUrlParameter": "HostedBaseUrl"
    },
    "s3": {
      "artifactBucketParameter": "ArtifactBucket",
      "artifactPrefixFormat": "enterprise/{environment}/FLOW-19/{commitSha}"
    },
    "secrets": {
      "managerRequired": true,
      "secretIdParameters": [
        "JwtSigningSecretId",
        "PlatformConnectionSecretId",
        "TenantBootstrapSecretId"
      ],
      "repositoryPolicy": "secret-ids-only-no-secret-values"
    },
    "kmsAndSigning": {
      "kmsKeyAliasParameter": "KmsKeyAlias",
      "signerProfileParameter": "SigningProfileName",
      "packageSigningRequired": true
    },
    "observability": {
      "cloudWatchLogGroupParameter": "CloudWatchLogGroup",
      "xrayEnabledParameter": "EnableXRay"
    },
    "rollback": {
      "rollbackTargetParameter": "RollbackTaskDefinitionArn",
      "mode": "previous-known-good-task-definition"
    }
  },
  "evidenceRows": [
    "CI-AWS-02",
    "CI-AWS-03",
    "CI-AWS-04",
    "CI-AWS-05",
    "CI-AWS-06",
    "CI-AWS-07",
    "CI-AWS-08",
    "CI-AWS-09",
    "CI-AWS-10",
    "CI-AWS-11",
    "CI-AWS-12",
    "CI-AWS-13"
  ]
}
